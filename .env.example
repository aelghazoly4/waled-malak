# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, default: wedding)
MONGODB_DB=wedding
# Password for /admin — long random string, 12+ characters
ADMIN_TOKEN=change-me-to-a-long-random-password
# Optional
INVITE_SLUG=walid-malak
EVENT_TZ=America/Chicago
# Extra origins allowed to call the API (comma separated) — only if the page is hosted elsewhere
ALLOWED_ORIGINS=
